{"lang":"ru","translations":{"about_heading":"\u041e \u043d\u0430\u0441","about_text":"\u041c\u044b \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e \u043b\u044e\u0431\u0438\u0442\u0435\u043b\u0435\u0439 \u043c\u0435\u0434\u043e\u0435\u0434\u043e\u0432 \u0438\u0437 \u0420\u043e\u0441\u0441\u0438\u0438, \u0410\u043d\u0433\u043b\u0438\u0438 \u0438 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438: \u0441\u043e\u0431\u0438\u0440\u0430\u0435\u043c \u0444\u0430\u043a\u0442\u044b \u0438 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u043e \u043d\u0430\u0448\u0435\u043c \u043b\u044e\u0431\u0438\u043c\u043e\u043c \u0437\u0432\u0435\u0440\u0435.","facts_heading":"\u0410 \u0432\u044b \u0437\u043d\u0430\u043b\u0438?","footer_text":"\u0421\u0434\u0435\u043b\u0430\u043d\u043e \u043d\u0430 \u043c\u0435\u0434\u0443 \u0438 \u043e\u0442\u0432\u0430\u0433\u0435.","gallery_heading":"\u0413\u0430\u043b\u0435\u0440\u0435\u044f","hero_subtitle":"\u0421\u0430\u043c\u043e\u0435 \u0431\u0435\u0441\u0441\u0442\u0440\u0430\u0448\u043d\u043e\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e \u043d\u0430 \u0417\u0435\u043c\u043b\u0435 - \u0444\u0430\u043d-\u0441\u0430\u0439\u0442.","hero_title":"\u041c\u0435\u0434\u043e\u0435\u0434\u044b","loading":"\u0417\u0430\u0433\u0440\u0443\u0437\u043a\u0430...","nav_about":"\u041e \u043d\u0430\u0441","nav_facts":"\u0424\u0430\u043a\u0442\u044b","nav_gallery":"\u0413\u0430\u043b\u0435\u0440\u0435\u044f","site_title":"\u041c\u0435\u0434\u043e\u0444\u0430\u043d\u0441"},"facts":[{"title":"\u0421\u0430\u043c\u044b\u0439 \u0431\u0435\u0441\u0441\u0442\u0440\u0430\u0448\u043d\u044b\u0439 \u0437\u0432\u0435\u0440\u044c \u043d\u0430 \u0441\u0432\u0435\u0442\u0435","body":"\u041c\u0435\u0434\u043e\u0435\u0434 \u0437\u0430\u043d\u0435\u0441\u0451\u043d \u0432 \u041a\u043d\u0438\u0433\u0443 \u0440\u0435\u043a\u043e\u0440\u0434\u043e\u0432 \u0413\u0438\u043d\u043d\u0435\u0441\u0441\u0430 \u043a\u0430\u043a \u0441\u0430\u043c\u043e\u0435 \u0431\u0435\u0441\u0441\u0442\u0440\u0430\u0448\u043d\u043e\u0435 \u0436\u0438\u0432\u043e\u0442\u043d\u043e\u0435: \u043e\u043d \u043d\u0435 \u043e\u0442\u0441\u0442\u0443\u043f\u0430\u0435\u0442 \u043f\u0435\u0440\u0435\u0434 \u043b\u044c\u0432\u0430\u043c\u0438, \u043b\u0435\u043e\u043f\u0430\u0440\u0434\u0430\u043c\u0438 \u0438 \u0433\u0438\u0435\u043d\u0430\u043c\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u043e \u043c\u043d\u043e\u0433\u043e \u0440\u0430\u0437 \u043a\u0440\u0443\u043f\u043d\u0435\u0435 \u0435\u0433\u043e.","image":"\/assets\/facts\/fearless.jpg"},{"title":"\u0428\u043a\u0443\u0440\u0430 \u043a\u0430\u043a \u0431\u0440\u043e\u043d\u044f","body":"\u041a\u043e\u0436\u0430 \u0443 \u043c\u0435\u0434\u043e\u0435\u0434\u0430 \u0442\u043e\u043b\u0441\u0442\u0430\u044f, \u0443\u043f\u0440\u0443\u0433\u0430\u044f \u0438 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e \u043f\u0440\u0438\u043b\u0435\u0433\u0430\u0435\u0442 \u043a \u0442\u0435\u043b\u0443, \u0447\u0442\u043e \u0441\u0445\u0432\u0430\u0447\u0435\u043d\u043d\u044b\u0439 \u0437\u0430 \u0448\u0435\u044e \u0437\u0432\u0435\u0440\u044c \u043c\u043e\u0436\u0435\u0442 \u0440\u0430\u0437\u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u0432 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0448\u043a\u0443\u0440\u0435 \u0438 \u0443\u043a\u0443\u0441\u0438\u0442\u044c \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430. \u0415\u0439 \u043d\u0438\u043f\u043e\u0447\u0451\u043c \u043f\u0447\u0435\u043b\u0438\u043d\u044b\u0435 \u0436\u0430\u043b\u0430, \u0438\u0433\u043b\u044b \u0434\u0438\u043a\u043e\u0431\u0440\u0430\u0437\u0430 \u0438 \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u0437\u043c\u0435\u0438\u043d\u044b\u0445 \u0437\u0443\u0431\u043e\u0432.","image":"\/assets\/facts\/armor-skin.jpg"},{"title":"\u041f\u0440\u0438\u0440\u043e\u0436\u0434\u0451\u043d\u043d\u044b\u0439 \u043c\u0430\u0441\u0442\u0435\u0440 \u043f\u043e\u0431\u0435\u0433\u0430","body":"\u041c\u0435\u0434\u043e\u0435\u0434\u044b \u043e\u0442\u043b\u0438\u0447\u043d\u043e \u0441\u043e\u043e\u0431\u0440\u0430\u0436\u0430\u044e\u0442: \u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043c\u0438, \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u044e\u0442 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u0434\u0440\u0443\u0433 \u043d\u0430 \u0434\u0440\u0443\u0433\u0430, \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u0431\u0440\u0430\u0442\u044c\u0441\u044f \u043f\u043e\u0432\u044b\u0448\u0435, \u0438 \u043b\u0435\u0433\u043a\u043e \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u044e\u0442\u0441\u044f, \u043a\u0430\u043a \u043e\u0442\u043a\u0440\u044b\u0442\u044c \u0437\u0430\u0434\u0432\u0438\u0436\u043a\u0443, \u0432\u043e\u0440\u043e\u0442\u0430 \u0438\u043b\u0438 \u0434\u0432\u0435\u0440\u0446\u0443 \u0432\u043e\u043b\u044c\u0435\u0440\u0430.","image":"\/assets\/facts\/escape-artist.jpg"},{"title":"\u042f\u0434 \u0435\u043c\u0443 \u043d\u0435 \u043f\u043e\u043c\u0435\u0445\u0430","body":"\u041c\u0435\u0434\u043e\u0435\u0434\u044b \u043e\u0445\u043e\u0442\u044f\u0442\u0441\u044f \u043d\u0430 \u043a\u043e\u0431\u0440 \u0438 \u0433\u0430\u0434\u044e\u043a \u0438 \u043f\u043e\u0435\u0434\u0430\u044e\u0442 \u0438\u0445. \u042f\u0434\u043e\u0432\u0438\u0442\u044b\u0439 \u0443\u043a\u0443\u0441 \u0441\u043f\u043e\u0441\u043e\u0431\u0435\u043d \u0432\u044b\u0440\u0443\u0431\u0438\u0442\u044c \u0437\u0432\u0435\u0440\u044f \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0447\u0430\u0441\u043e\u0432, \u043d\u043e \u0437\u0430\u0442\u0435\u043c \u043e\u043d \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442 \u0432 \u0441\u0435\u0431\u044f, \u0432\u0441\u0442\u0440\u044f\u0445\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0438 \u0434\u043e\u0435\u0434\u0430\u0435\u0442 \u0434\u043e\u0431\u044b\u0447\u0443.","image":"\/assets\/facts\/venom-proof.jpg"},{"title":"\u0421\u043b\u0430\u0434\u043a\u043e\u0435\u0436\u043a\u0430 \u0441\u043e \u0441\u0442\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u043d\u0435\u0440\u0432\u0430\u043c\u0438","body":"\u041c\u0435\u0434\u043e\u0435\u0434\u044b \u0432\u0441\u043a\u0440\u044b\u0432\u0430\u044e\u0442 \u0434\u0438\u043a\u0438\u0435 \u0443\u043b\u044c\u0438 \u0440\u0430\u0434\u0438 \u043c\u0451\u0434\u0430 \u0438 \u043f\u0438\u0442\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043b\u0438\u0447\u0438\u043d\u043e\u043a, \u043f\u043e\u0447\u0442\u0438 \u043d\u0435 \u043e\u0431\u0440\u0430\u0449\u0430\u044f \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u044f \u043d\u0430 \u0440\u043e\u0439 \u0440\u0430\u0437\u044a\u044f\u0440\u0451\u043d\u043d\u044b\u0445 \u043f\u0447\u0451\u043b.","image":"\/assets\/facts\/beehive-raider.jpg"},{"title":"\u0412 \u043a\u043e\u043c\u0430\u043d\u0434\u0435 \u0441 \u043f\u0442\u0438\u0446\u0435\u0439","body":"\u041f\u0442\u0438\u0446\u0430-\u043c\u0435\u0434\u043e\u0443\u043a\u0430\u0437\u0447\u0438\u043a \u043e\u0441\u043e\u0431\u044b\u043c \u043a\u0440\u0438\u043a\u043e\u043c \u0437\u043e\u0432\u0451\u0442 \u043c\u0435\u0434\u043e\u0435\u0434\u0430 \u043a \u0434\u0438\u043a\u043e\u043c\u0443 \u043f\u0447\u0435\u043b\u0438\u043d\u043e\u043c\u0443 \u0433\u043d\u0435\u0437\u0434\u0443. \u0417\u0432\u0435\u0440\u044c \u0432\u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0433\u043d\u0435\u0437\u0434\u043e \u0438 \u0434\u0435\u043b\u0438\u0442 \u0434\u043e\u0431\u044b\u0447\u0443 \u0441 \u043f\u0442\u0438\u0446\u0435\u0439 - \u0440\u0435\u0434\u043a\u0438\u0439 \u043f\u0440\u0438\u043c\u0435\u0440 \u0441\u043e\u044e\u0437\u0430 \u043f\u0442\u0438\u0446\u044b \u0438 \u043c\u043b\u0435\u043a\u043e\u043f\u0438\u0442\u0430\u044e\u0449\u0435\u0433\u043e.","image":"\/assets\/facts\/honeyguide.jpg"},{"title":"\u0421\u043e\u0437\u0434\u0430\u043d, \u0447\u0442\u043e\u0431\u044b \u043a\u043e\u043f\u0430\u0442\u044c","body":"\u0414\u043b\u0438\u043d\u043d\u044b\u043c\u0438 \u043c\u043e\u0449\u043d\u044b\u043c\u0438 \u043a\u043e\u0433\u0442\u044f\u043c\u0438 \u043c\u0435\u0434\u043e\u0435\u0434 \u0437\u0430 \u0441\u0447\u0438\u0442\u0430\u043d\u044b\u0435 \u043c\u0438\u043d\u0443\u0442\u044b \u0440\u043e\u0435\u0442 \u043d\u043e\u0440\u0443 \u0432 \u0442\u0432\u0451\u0440\u0434\u043e\u0439 \u0437\u0435\u043c\u043b\u0435, \u0447\u0442\u043e\u0431\u044b \u0434\u043e\u0431\u044b\u0442\u044c \u0435\u0434\u0443, \u0441\u043a\u0440\u044b\u0442\u044c\u0441\u044f \u043e\u0442 \u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u0438\u043b\u0438 \u0443\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u043b\u043e\u0433\u043e\u0432\u043e.","image":"\/assets\/facts\/digging-claws.jpg"},{"title":"\u041b\u0435\u0433\u0435\u043d\u0434\u0430 \u043f\u043e \u0438\u043c\u0435\u043d\u0438 \u0421\u0442\u043e\u0444\u0444\u0435\u043b\u044c","body":"\u0421\u0442\u043e\u0444\u0444\u0435\u043b\u044c, \u043c\u0435\u0434\u043e\u0435\u0434 \u0438\u0437 \u044e\u0436\u043d\u043e\u0430\u0444\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u0438\u044e\u0442\u0430, \u043f\u0440\u043e\u0441\u043b\u0430\u0432\u0438\u043b\u0441\u044f \u043f\u043e\u0431\u0435\u0433\u0430\u043c\u0438 \u0438\u0437 \u043b\u044e\u0431\u043e\u0433\u043e \u0432\u043e\u043b\u044c\u0435\u0440\u0430: \u043a\u0430\u0440\u0430\u0431\u043a\u0430\u043b\u0441\u044f \u043f\u043e \u0441\u0442\u0435\u043d\u0430\u043c, \u043e\u0442\u043f\u0438\u0440\u0430\u043b \u0432\u043e\u0440\u043e\u0442\u0430 \u0438 \u0434\u0430\u0436\u0435 \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u043b \u043a\u0430\u043c\u043d\u0438 \u0438 \u0433\u0440\u044f\u0437\u044c, \u0447\u0442\u043e\u0431\u044b \u043f\u0435\u0440\u0435\u043b\u0435\u0437\u0442\u044c \u0447\u0435\u0440\u0435\u0437 \u043e\u0433\u0440\u0430\u0434\u0443.","image":"\/assets\/facts\/stoffel.jpg"},{"title":"\u0412\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442\u0441\u044f \u043d\u0430 \u0434\u0432\u0443\u0445 \u043a\u043e\u043d\u0442\u0438\u043d\u0435\u043d\u0442\u0430\u0445","body":"\u041c\u0435\u0434\u043e\u0435\u0434\u044b \u0436\u0438\u0432\u0443\u0442 \u043f\u043e\u0447\u0442\u0438 \u043f\u043e \u0432\u0441\u0435\u0439 \u0410\u0444\u0440\u0438\u043a\u0435 \u044e\u0436\u043d\u0435\u0435 \u0421\u0430\u0445\u0430\u0440\u044b \u0438 \u0432 \u0410\u0437\u0438\u0438, \u043e\u0442 \u0410\u0440\u0430\u0432\u0438\u0439\u0441\u043a\u043e\u0433\u043e \u043f\u043e\u043b\u0443\u043e\u0441\u0442\u0440\u043e\u0432\u0430 \u0434\u043e \u0418\u043d\u0434\u0438\u0438, \u0438 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u043e \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044e\u0442 \u0441\u0435\u0431\u044f \u0438 \u0432 \u043f\u0443\u0441\u0442\u044b\u043d\u0435, \u0438 \u0432 \u043b\u0435\u0441\u0443.","image":"\/assets\/facts\/range.jpg"},{"title":"\u0412\u0435\u0447\u043d\u044b\u0439 \u0441\u0442\u0440\u0430\u043d\u043d\u0438\u043a","body":"\u041c\u0435\u0434\u043e\u0435\u0434 \u043e\u0431\u044b\u0447\u043d\u043e \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0432 \u043e\u0434\u0438\u043d\u043e\u0447\u043a\u0443. \u0412 \u043f\u043e\u0438\u0441\u043a\u0430\u0445 \u043f\u0438\u0449\u0438 \u043e\u043d \u0437\u0430 \u0434\u0435\u043d\u044c \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043a\u0438\u043b\u043e\u043c\u0435\u0442\u0440\u043e\u0432, \u0438\u0441\u0441\u043b\u0435\u0434\u0443\u044f \u043d\u043e\u0440\u044b, \u0440\u0430\u0441\u0449\u0435\u043b\u0438\u043d\u044b \u0438 \u0432\u0441\u0451, \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0435\u0442 \u0435\u0433\u043e \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435.","image":"\/assets\/facts\/wanderer.jpg"}]}