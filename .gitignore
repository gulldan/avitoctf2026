# ==========================================================================
# Curated CTF technical reports repository.
# Ignore by default, then include reports, task briefs, reproducible solvers,
# minimal input/result fixtures, and root project configuration.
# Scratch files, virtual environments, dumps, nonessential captures, credentials, extracted
# trees, and archives (except the required Goliath fixture) stay out of git.
# ==========================================================================
*

# --- repo config / metadata ---
!/.gitignore
!/.python-version
!/README.md
!/MEMES.md
!/WRITEUP_TEMPLATE.md
!/pyproject.toml
!/uv.lock

# --- Unicode-steganography report and scanner (images stay OUT of git) ---
!/memes/
!memes/HIDDEN_EGGS_REPORT.md
!memes/meme_scan.py

# --- task folders + their write-ups and briefs ---
!/task*/
!task*/*_writeup.md
!task*/task.md
!/returns/
!returns/*_writeup.md
!returns/task.md
!returns/FLAG.txt

